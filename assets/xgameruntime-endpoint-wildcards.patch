+/* This deliberately accepts only a flat diagnostic object: unescaped keys,
+ * string/unsigned-integer/boolean/null values, and one integer XErr. Unknown
+ * or unsupported shapes yield no metadata. No COM/JSON parser or logging call
+ * sees the body; in particular Wine's JSON implementation traces its input. */
+static void xsts_error_space( const BYTE **cursor, const BYTE *end )
+{
+    while (*cursor < end && (**cursor == ' ' || **cursor == '\t' ||
+           **cursor == '\r' || **cursor == '\n')) ++*cursor;
+}
+
+static BOOL xsts_error_string( const BYTE **cursor, const BYTE *end,
+                               const BYTE **start, SIZE_T *length, BOOL *escaped )
+{
+    const BYTE *p = *cursor;
+    if (p == end || *p++ != '"') return FALSE;
+    *start = p;
+    *escaped = FALSE;
+    while (p < end)
+    {
+        BYTE c = *p++;
+        if (c == '"')
+        {
+            *length = p - *start - 1;
+            *cursor = p;
+            return TRUE;
+        }
+        if (c < 0x20) return FALSE;
+        if (c != '\\') continue;
+        *escaped = TRUE;
+        if (p == end) return FALSE;
+        c = *p++;
+        if (c == 'u')
+        {
+            if (end - p < 4) return FALSE;
+            for (unsigned i = 0; i < 4; ++i, ++p)
+                if (!((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') ||
+                      (*p >= 'A' && *p <= 'F'))) return FALSE;
+        }
+        else if (c != '"' && c != '\\' && c != '/' && c != 'b' &&
+                 c != 'f' && c != 'n' && c != 'r' && c != 't') return FALSE;
+    }
+    return FALSE;
+}
+
+static BOOL xsts_error_uint( const BYTE **cursor, const BYTE *end, DWORD *value )
+{
+    const BYTE *p = *cursor;
+    DWORD number = 0;
+    if (p == end || *p < '0' || *p > '9') return FALSE;
+    if (*p == '0' && p + 1 < end && p[1] >= '0' && p[1] <= '9') return FALSE;
+    do
+    {
+        unsigned digit = *p++ - '0';
+        if (number > (UINT32_MAX - digit) / 10) return FALSE;
+        number = number * 10 + digit;
+    } while (p < end && *p >= '0' && *p <= '9');
+    *cursor = p;
+    *value = number;
+    return TRUE;
+}
+
+static BOOL xsts_error_utf8( const BYTE *p, const BYTE *end )
+{
+    while (p < end)
+    {
+        BYTE c = *p++;
+        unsigned count;
+        if (c < 0x80) continue;
+        if (c >= 0xc2 && c <= 0xdf) count = 1;
+        else if (c >= 0xe0 && c <= 0xef) count = 2;
+        else if (c >= 0xf0 && c <= 0xf4) count = 3;
+        else return FALSE;
+        if (end - p < count) return FALSE;
+        if ((c == 0xe0 && *p < 0xa0) || (c == 0xed && *p >= 0xa0) ||
+            (c == 0xf0 && *p < 0x90) || (c == 0xf4 && *p >= 0x90)) return FALSE;
+        while (count--) if ((*p++ & 0xc0) != 0x80) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL xsts_error_code( const BYTE *buffer, SIZE_T size, DWORD *code )
+{
+    const BYTE *p, *end, *text;
+    SIZE_T length;
+    DWORD number, result = 0;
+    BOOL escaped, found = FALSE;
+
+    if (!code) return FALSE;
+    *code = 0;
+    if (!buffer || !size || size > 16384) return FALSE;
+    if (!xsts_error_utf8(buffer, buffer + size)) return FALSE;
+    p = buffer;
+    end = buffer + size;
+    xsts_error_space(&p, end);
+    if (p == end || *p++ != '{') return FALSE;
+    xsts_error_space(&p, end);
+    if (p == end || *p == '}') return FALSE;
+    for (;;)
+    {
+        BOOL target;
+        if (!xsts_error_string(&p, end, &text, &length, &escaped) || escaped) return FALSE;
+        target = length == 4 && !memcmp(text, "XErr", 4);
+        xsts_error_space(&p, end);
+        if (p == end || *p++ != ':') return FALSE;
+        xsts_error_space(&p, end);
+        if (p == end) return FALSE;
+        if (target)
+        {
+            if (found || !xsts_error_uint(&p, end, &result)) return FALSE;
+            found = TRUE;
+        }
+        else if (*p == '"')
+        {
+            if (!xsts_error_string(&p, end, &text, &length, &escaped)) return FALSE;
+        }
+        else if (*p >= '0' && *p <= '9')
+        {
+            if (!xsts_error_uint(&p, end, &number)) return FALSE;
+        }
+        else if (end - p >= 4 && (!memcmp(p, "null", 4) || !memcmp(p, "true", 4))) p += 4;
+        else if (end - p >= 5 && !memcmp(p, "false", 5)) p += 5;
+        else return FALSE;
+        xsts_error_space(&p, end);
+        if (p == end) return FALSE;
+        if (*p == '}') { ++p; break; }
+        if (*p++ != ',') return FALSE;
+        xsts_error_space(&p, end);
+    }
+    xsts_error_space(&p, end);
+    if (p != end || !found) return FALSE;
+    *code = result;
+    return TRUE;
+}
