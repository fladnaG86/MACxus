+#[test]
+fn xbox_ticket_jwe_uses_t_prefix_without_changing_stored_token_or_ciphertext() {
+    for raw in [
+        jwe(json!({"alg":"dir","enc":"A128CBC-HS256"}), ""),
+        jwe(json!({"alg":"RSA-OAEP-256","enc":"A256GCM"}), "a2V5"),
+    ] {
+        let Token::Compact(stored) = delegation(&raw) else { panic!("fixture"); };
+        assert_eq!(stored, format!("d={raw}"));
+        for input in [stored.clone(), raw.clone(), format!("t={raw}")] {
+            assert_eq!(xbox_ticket(input), format!("t={raw}"));
+        }
+        assert_eq!(store_ticket(stored.clone()), format!("t={raw}"));
+        assert_eq!(licensing_ticket(stored), raw);
+    }
+}
+
+#[test]
+fn xbox_ticket_keeps_legacy_and_malformed_values_byte_exact() {
+    let valid = jwe(json!({"alg":"dir","enc":"A256GCM"}), "");
+    let oversized = jwe(json!({"alg":"dir","enc":"A256GCM","kid":"a".repeat(9000)}), "");
+    for input in [
+        "d=opaque".to_string(), "t=opaque&p=proof".into(), "opaque".into(),
+        "".into(), "d=".into(), "d=eyJ.abc".into(),
+        "d=eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiIxIn0.c2ln".into(),
+        "d=opaque..iv.ciphertext.tag".into(),
+        format!("d={valid}.extra"), format!("d={oversized}"),
+        format!("d={}", valid.replace("..", ".+.")),
+        format!("d={}", jwe(json!({"alg":"dir"}), "")),
+    ] {
+        assert_eq!(xbox_ticket(input.clone()), input);
+    }
 }
 
