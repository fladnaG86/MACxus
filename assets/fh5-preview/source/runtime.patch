+static HRESULT content_discovery_anchor( WCHAR *path, const struct content_game *current )
+{
+    WCHAR configured[MAX_PATH], absolute[MAX_PATH];
+    struct content_package *packages;
+    char launched_id[33], installed_id[33];
+    DWORD length;
+    BOOL match;
+
+    length = GetEnvironmentVariableW(L"XODUS_CONTENT_PACKAGE_ROOT", configured, MAX_PATH);
+    if (!length) return S_OK;
+    if (length >= MAX_PATH || !content_absolute(configured)) return E_INVALIDARG;
+    length = GetFullPathNameW(configured, MAX_PATH, absolute, NULL);
+    if (!length || length >= MAX_PATH) return E_INVALIDARG;
+    while (length > 3 && (absolute[length - 1] == '\\' || absolute[length - 1] == '/')) absolute[--length] = 0;
+    if (!(packages = calloc(2, sizeof(*packages)))) return E_OUTOFMEMORY;
+    match = content_load(path, &packages[0]) && !packages[0].content &&
+            content_load(absolute, &packages[1]) && !packages[1].content &&
+            !strcmp(current->identity, packages[0].identity) &&
+            !strcmp(current->publisher, packages[0].publisher_id) &&
+            !strcmp(current->store, packages[0].store) &&
+            !strcmp(packages[0].identity, packages[1].identity) &&
+            !strcmp(packages[0].publisher_id, packages[1].publisher_id) &&
+            !strcmp(packages[0].store, packages[1].store) &&
+            !memcmp(&packages[0].version, &packages[1].version, sizeof(XVersion)) &&
+            content_unique_layout_id(path, launched_id) &&
+            content_unique_layout_id(absolute, installed_id) && !stricmp(launched_id, installed_id);
+    free(packages);
+    if (!match) return E_INVALIDARG;
+    wcscpy(path, absolute);
+    return S_OK;
+}
