+static HRESULT addon_parse_inventory( const char *bytes, UINT16 size, struct addon_inventory **out )
+{
+    xmlDocPtr doc = NULL;
+    xmlNodePtr root, node, child;
+    struct addon_inventory *inventory = NULL;
+    char *parent = NULL, *id = NULL, *offer = NULL, *sku = NULL;
+    UINT64 value;
+    BOOLEAN complete;
+    UINT32 i, j;
+    HRESULT hr = E_UNEXPECTED;
+    *out = NULL;
+    if (!bytes || !size || strstr(bytes,"<!DOCTYPE") || strstr(bytes,"<!ENTITY")) return hr;
+    doc = xmlReadMemory(bytes,size,NULL,NULL,XML_PARSE_NONET|XML_PARSE_NOERROR|XML_PARSE_NOWARNING);
+    if (!doc) return hr;
+    root = xmlDocGetRootElement(doc);
+    if (doc->intSubset || doc->extSubset || !root || strcmp((char *)root->name,"Response")) goto done;
+    if (FAILED(entitled_uint(root,"HResult",&value)) || value > UINT32_MAX) goto done;
+    if (FAILED(hr = (HRESULT)value)) goto done;
+    hr = E_UNEXPECTED;
+    parent = entitled_text(root,"ParentProductId");
+    if (!parent || !entitled_id(parent) || strcmp(parent,storeId) ||
+        FAILED(entitled_bool(root,"InventoryComplete",&complete)) || !complete) goto done;
+    if (!(inventory = calloc(1,sizeof(*inventory)))) { hr = E_OUTOFMEMORY; goto done; }
+    if (FAILED(entitled_uint(root,"ValidUntil",&inventory->valid_until)) ||
+        inventory->valid_until <= (UINT64)time(NULL) || inventory->valid_until > (UINT64)time(NULL)+125) goto done;
+    for (node=root->children;node;node=node->next)
+    {
+        struct addon_candidate *product;
+        if (node->type!=XML_ELEMENT_NODE || strcmp((char*)node->name,"Product")) continue;
+        if (inventory->count==ADDON_MAX_CANDIDATES) goto done;
+        product=&inventory->products[inventory->count];
+        id=entitled_text(node,"StoreId");offer=entitled_text(node,"InAppOfferToken");
+        if (!entitled_id(id) || !strcmp(id,storeId) || !offer || strlen(offer)>63 ||
+            FAILED(entitled_bool(node,"AssociatedDurable",&product->associated))) goto done;
+        for (i=0;i<inventory->count;i++) if (!strcmp(inventory->products[i].id,id)) goto done;
+        memcpy(product->id,id,13);strcpy(product->offer,offer);free(id);id=NULL;free(offer);offer=NULL;
+        for (child=node->children;child;child=child->next)
+        {
+            if (child->type!=XML_ELEMENT_NODE || strcmp((char*)child->name,"Sku")) continue;
+            if (product->sku_count==ENTITLED_MAX_SKUS) goto done;
+            sku=entitled_text(child,"SkuId");
+            if (!entitled_sku_id(sku) || FAILED(entitled_bool(child,"HasPackages",&product->skus[product->sku_count].packaged))) goto done;
+            for (j=0;j<product->sku_count;j++) if (!strcmp(product->skus[j].id,sku)) goto done;
+            memcpy(product->skus[product->sku_count++].id,sku,5);free(sku);sku=NULL;
+        }
+        if ((product->associated && !product->sku_count) || (!product->associated && product->sku_count)) goto done;
+        inventory->count++;
+    }
+    *out=inventory;inventory=NULL;hr=S_OK;
+done:
+    free(parent);free(id);free(offer);free(sku);free(inventory);xmlFreeDoc(doc);return hr;
+}
