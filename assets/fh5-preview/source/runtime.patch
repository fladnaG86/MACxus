+static void addon_async_release( struct addon_async *context )
+{
+    if (InterlockedDecrement(&context->refs)) return;
+    free(context->licenses);IXThreadingImpl_Release(context->threading);free(context);
+}
+static DWORD WINAPI addon_worker( void *arg )
+{
+    struct addon_async *context=arg;
+    HRESULT hr=E_ABORT;
+    if (!InterlockedCompareExchange(&context->canceled,0,0)) hr=addon_fetch(context);
+    if (InterlockedCompareExchange(&context->canceled,0,0)) hr=E_ABORT;
+    xodus_store_license_note("store-addon-result",hr);
+    IXThreadingImpl_XAsyncComplete(context->threading,context->async,hr,SUCCEEDED(hr)?context->count*sizeof(XStoreAddonLicense):0);
+    addon_async_release(context);return 0;
+}
+static HRESULT WINAPI addon_provider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct addon_async *context=data->context;
+    HANDLE worker;HRESULT hr;
+    switch(op)
+    {
+    case XAsyncOp_Begin:return IXThreadingImpl_XAsyncSchedule(context->threading,data->async,0);
+    case XAsyncOp_DoWork:
+        if (InterlockedCompareExchange(&context->started,1,0)) return E_PENDING;
+        if (InterlockedCompareExchange(&context->canceled,0,0)) return E_ABORT;
+        context->async=data->async;InterlockedIncrement(&context->refs);
+        if (!(worker=CreateThread(NULL,0,addon_worker,context,0,NULL))) { hr=HRESULT_FROM_WIN32(GetLastError());addon_async_release(context);return hr; }
+        CloseHandle(worker);return E_PENDING;
+    case XAsyncOp_GetResult:
+        if (!data->buffer || data->bufferSize<context->count*sizeof(XStoreAddonLicense)) return E_INVALIDARG;
+        if (context->proof_until<=(UINT64)time(NULL)) return E_ACCESSDENIED;
+        if (context->count) memcpy(data->buffer,context->licenses,context->count*sizeof(XStoreAddonLicense));
+        return S_OK;
+    case XAsyncOp_Cancel:InterlockedExchange(&context->canceled,TRUE);return S_OK;
+    case XAsyncOp_Cleanup:addon_async_release(context);return S_OK;
+    default:return S_OK;
+    }
+}
+static HRESULT addon_begin( XStoreContextHandle store, XAsyncBlock *async )
+{
+    struct addon_async *context;UINT64 xuid;HRESULT hr;
+    if (!async) return E_INVALIDARG;
+    if (FAILED(hr=entitled_store_user(store,&xuid))) return hr;
+    if (!entitled_id(storeId)) return E_GAME_MISSING_GAME_CONFIG;
+    if (!(context=calloc(1,sizeof(*context)))) return E_OUTOFMEMORY;
+    context->refs=1;
+    if (FAILED(hr=QueryApiImpl(&CLSID_XThreadingImpl,&IID_IXThreadingImpl,(void**)&context->threading))) { free(context);return hr; }
+    hr=IXThreadingImpl_XAsyncBegin(context->threading,async,context,&addon_identity,"XStoreQueryAddOnLicenses",addon_provider);
+    if (FAILED(hr)) addon_async_release(context);
+    return hr;
+}
+static HRESULT addon_count( XAsyncBlock *async, UINT32 *count )
+{
+    IXThreadingImpl *threading;SIZE_T size;HRESULT hr;
+    if (!async || !count) return E_INVALIDARG;
+    *count=0;
+    if (FAILED(hr=QueryApiImpl(&CLSID_XThreadingImpl,&IID_IXThreadingImpl,(void**)&threading))) return hr;
+    hr=IXThreadingImpl_XAsyncGetResultSize(threading,async,&size);IXThreadingImpl_Release(threading);
+    if (FAILED(hr)) return hr;
+    if (size%sizeof(XStoreAddonLicense) || size/sizeof(XStoreAddonLicense)>ENTITLED_MAX_PRODUCTS) return E_UNEXPECTED;
+    *count=size/sizeof(XStoreAddonLicense);return S_OK;
+}
+static HRESULT addon_result( XAsyncBlock *async, UINT32 capacity, XStoreAddonLicense *out )
+{
+    IXThreadingImpl *threading;UINT32 count;HRESULT hr;
+    if (!async || (capacity && !out)) return E_INVALIDARG;
+    if (FAILED(hr=addon_count(async,&count))) return hr;
+    if (capacity<count) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    if (FAILED(hr=QueryApiImpl(&CLSID_XThreadingImpl,&IID_IXThreadingImpl,(void**)&threading))) return hr;
+    /* Empty native async payloads complete/clean up without requiring Result.
+     * Count remains readable and optional zero-size Result is still valid. */
+    hr=IXThreadingImpl_XAsyncGetResult(threading,async,&addon_identity,count*sizeof(XStoreAddonLicense),count?out:NULL,NULL);
+    IXThreadingImpl_Release(threading);return hr;
+}
