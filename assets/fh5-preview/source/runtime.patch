+static HRESULT addon_materialize( const struct addon_inventory *inventory, const struct receipt_license *licenses,
+    UINT32 license_count, UINT64 proof_until, XStoreAddonLicense **out, UINT32 *count )
+{
+    UINT32 i,j,k,written=0;
+    BOOL base=FALSE;
+    XStoreAddonLicense *result;
+    UINT64 now=time(NULL);
+    *out=NULL;*count=0;
+    if (proof_until<=now || inventory->valid_until<=now) return E_ACCESSDENIED;
+    for (i=0;i<license_count;i++) if (!strcmp(licenses[i].id,storeId) && licenses[i].expiry>now) base=TRUE;
+    if (!base) return E_ACCESSDENIED; /* This runtime mounts digital Store titles only. */
+    if (!(result=calloc(license_count?license_count:1,sizeof(*result)))) return E_OUTOFMEMORY;
+    for (i=0;i<license_count;i++)
+    {
+        const struct addon_candidate *product;
+        if (!strcmp(licenses[i].id,storeId)) continue;
+        for (j=0;j<inventory->count && strcmp(inventory->products[j].id,licenses[i].id);j++);
+        if (j==inventory->count) continue; /* A broader receipt cannot add unrelated IDs. */
+        product=&inventory->products[j];
+        if (!product->associated) { free(result);return E_NOTIMPL; }
+        for (k=0;k<product->sku_count && strcmp(product->skus[k].id,licenses[i].sku);k++);
+        if (k==product->sku_count) { free(result);return E_NOTIMPL; }
+        if (product->skus[k].packaged) continue;
+        snprintf(result[written].skuStoreId,sizeof(result[written].skuStoreId),"%s/%s",licenses[i].id,licenses[i].sku);
+        strcpy(result[written].inAppOfferToken,product->offer);
+        result[written].isActive=licenses[i].expiry>now;result[written].expirationDate=licenses[i].expiry;written++;
+    }
+    *out=result;*count=written;return S_OK;
+}
