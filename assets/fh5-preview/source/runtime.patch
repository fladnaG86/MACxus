+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Durable add-on discovery from the authenticated launcher, followed by genuine
+ * nonce/signature/expiry-verified Microsoft SKU licenses. Discovery is not proof
+ * of ownership. Unknown licensed kinds/SKUs fail rather than fabricate results. */
+#define ADDON_MAX_CANDIDATES 255
+struct addon_sku { char id[5]; BOOLEAN packaged; };
+struct addon_candidate
+{
+    char id[13], offer[64];
+    BOOLEAN associated;
+    UINT32 sku_count;
+    struct addon_sku skus[ENTITLED_MAX_SKUS];
+};
+struct addon_inventory
+{
+    UINT32 count;
+    UINT64 valid_until;
+    struct addon_candidate products[ADDON_MAX_CANDIDATES];
+};
+struct addon_async
+{
+    LONG refs, canceled, started;
+    IXThreadingImpl *threading;
+    XAsyncBlock *async;
+    UINT32 count;
+    UINT64 proof_until;
+    XStoreAddonLicense *licenses;
+};
