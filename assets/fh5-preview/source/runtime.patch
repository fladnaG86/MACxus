+/* Keep signed inactive rows as inactive; unlike an ownership-products query,
+ * this API exposes isActive and expirationDate. Never turn expiry into a grant. */
+static HRESULT addon_receipt_inventory( IJsonObject *claim, const char **ids, UINT32 count,
+    struct receipt_license *licenses, UINT32 *license_count )
+{
+    IJsonArray *array=NULL;
+    IJsonObject *row=NULL;
+    UINT32 size,i,j;
+    double version;
+    char *id=NULL,*sku=NULL,*end=NULL;
+    UINT64 until;
+    HRESULT hr=E_UNEXPECTED;
+    if (FAILED(receipt_get_number(claim,L"tokenVersion",&version)) || version!=1 ||
+        FAILED(receipt_get_array(claim,L"licensableProducts",&array)) ||
+        FAILED(receipt_array_size(array,&size)) || size>512) goto done;
+    for (i=0;i<size;i++)
+    {
+        hr=E_UNEXPECTED;
+        if (FAILED(IJsonArray_GetObjectAt(array,i,&row))) goto done;
+        id=receipt_string(row,L"productId",12);sku=receipt_string(row,L"skuId",4);end=receipt_string(row,L"endDate",64);
+        if (!entitled_id(id) || !entitled_sku_id(sku) || !end || FAILED(receipt_date(end,&until)) || until>INT64_MAX) goto done;
+        for (j=0;j<count && strcmp(ids[j],id);j++);
+        if (j<count)
+        {
+            for (j=0;j<*license_count;j++) if (!strcmp(licenses[j].id,id) && !strcmp(licenses[j].sku,sku)) break;
+            if (j<*license_count) { if (until<licenses[j].expiry) licenses[j].expiry=until; }
+            else
+            {
+                if (*license_count==ENTITLED_MAX_PRODUCTS) goto done;
+                memcpy(licenses[*license_count].id,id,13);memcpy(licenses[*license_count].sku,sku,5);licenses[(*license_count)++].expiry=until;
+            }
+        }
+        free(id);id=NULL;free(sku);sku=NULL;free(end);end=NULL;IJsonObject_Release(row);row=NULL;
+    }
+    hr=S_OK;
+done:
+    if (array) IJsonArray_Release(array);
+    if (row) IJsonObject_Release(row);
+    free(id);free(sku);free(end);return hr;
+}
