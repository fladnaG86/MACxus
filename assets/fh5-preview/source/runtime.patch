+/* A materialized executable lives in a transient view. Discovery must use
+ * the original package installation, never arbitrary siblings of a host temp
+ * directory. An explicit anchor is admitted only when both on-disk manifests,
+ * version and unique layout identifier match the launched package. */
+static BOOL content_unique_layout_id( const WCHAR *path, char *identifier )
+{
+    WCHAR pattern[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+    UINT count = 0;
+    BOOL valid = TRUE;
+
+    if (!content_join(path, L"layout_*.xml", pattern) ||
+        (find = FindFirstFileW(pattern, &data)) == INVALID_HANDLE_VALUE) return FALSE;
+    do
+    {
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        if (++count != 1 || !content_layout_id(data.cFileName, identifier)) { valid = FALSE; break; }
+    } while (FindNextFileW(find, &data));
+    FindClose(find);
+    return valid && count == 1;
+}
