+static HRESULT addon_fetch( struct addon_async *context )
+{
+    struct addon_inventory *inventory=NULL;
+    struct receipt_license licenses[ENTITLED_MAX_PRODUCTS];
+    const char *ids[ENTITLED_MAX_PRODUCTS];
+    char request[256],*response=NULL,market[3]="US";
+    WCHAR country[16];
+    UINT16 size;
+    UINT32 count=0,batch,i;
+    UINT64 proof_until=UINT64_MAX;
+    HRESULT hr,com=CoInitializeEx(NULL,COINIT_MULTITHREADED);
+    if (GetLocaleInfoEx(LOCALE_NAME_USER_DEFAULT,LOCALE_SISO3166CTRYNAME,country,ARRAY_SIZE(country)))
+        WideCharToMultiByte(CP_UTF8,0,country,-1,market,sizeof(market),NULL,NULL);
+    if (strlen(market)!=2 || market[0]<'A' || market[0]>'Z' || market[1]<'A' || market[1]>'Z') { hr=E_INVALIDARG;goto done; }
+    snprintf(request,sizeof(request),"<Request><ParentProductId>%s</ParentProductId><Market>%s</Market></Request>",storeId,market);
+    hr=xodus_store_addon_inventory_xml(request,strlen(request),&response,&size);
+    if (SUCCEEDED(hr)) hr=addon_parse_inventory(response,size,&inventory);
+    xodus_store_license_note("store-addon-discovery",hr);
+    if (FAILED(hr)) goto done;
+    ids[0]=storeId;
+    for (i=0;i<inventory->count;i++) ids[i+1]=inventory->products[i].id;
+    for (batch=0;batch<inventory->count+1;batch+=64)
+    {
+        BYTE random[32];char nonce[65],*body=NULL,*jwt=NULL;
+        IJsonObject *claim=NULL;UINT64 expiry;
+        if (InterlockedCompareExchange(&context->canceled,0,0)) { hr=E_ABORT;goto done; }
+        if (inventory->valid_until<=(UINT64)time(NULL)) { hr=E_ACCESSDENIED;goto done; }
+        if (BCryptGenRandom(NULL,random,sizeof(random),BCRYPT_USE_SYSTEM_PREFERRED_RNG)) { hr=E_FAIL;goto done; }
+        for (i=0;i<32;i++) sprintf(nonce+2*i,"%02x",random[i]);
+        hr=xodus_store_license_body(ids+batch,min(64,inventory->count+1-batch),nonce,&body);
+        if (SUCCEEDED(hr)) hr=xodus_store_license_xml(body,strlen(body),&jwt);
+        free(body);
+        if (SUCCEEDED(hr)) hr=receipt_load(jwt,nonce,&claim,&expiry);
+        if (jwt) { SecureZeroMemory(jwt,strlen(jwt));free(jwt); }
+        if (SUCCEEDED(hr))
+        {
+            proof_until=min(proof_until,expiry);
+            hr=addon_receipt_inventory(claim,ids+batch,min(64,inventory->count+1-batch),licenses,&count);
+        }
+        if (claim) IJsonObject_Release(claim);
+        xodus_store_license_note("store-addon-receipt",hr);
+        if (FAILED(hr)) goto done;
+    }
+    hr=addon_materialize(inventory,licenses,count,proof_until,&context->licenses,&context->count);
+    context->proof_until=min(proof_until,inventory->valid_until);
+done:
+    free(response);free(inventory);if (SUCCEEDED(com)) CoUninitialize();return hr;
+}
