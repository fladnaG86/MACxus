+/* Appending a title's policy table must not invalidate the pointers already
+ * held by default endpoints. Allocate first, rebase against the still-live old
+ * array, then retire that array. Keep the private IUser endpoint ABI unchanged. */
+static HRESULT append_endpoint_policies( XUserHandle user, UINT32 count, struct policy **appended )
+{
+    struct policy *replacement;
+    *appended = NULL;
+    if (!count) return S_OK;
+    if (count > UINT32_MAX - user->policiesLen ||
+        (SIZE_T)user->policiesLen + count > SIZE_MAX / sizeof(*replacement)) return E_OUTOFMEMORY;
+    if (!(replacement = calloc((SIZE_T)user->policiesLen + count, sizeof(*replacement)))) return E_OUTOFMEMORY;
+    if (user->policiesLen) memcpy(replacement, user->policies, user->policiesLen * sizeof(*replacement));
+    for (UINT32 i = 0; i < user->endpointsLen; ++i)
+        if (user->endpoints[i].policy)
+            user->endpoints[i].policy = replacement + (user->endpoints[i].policy - user->policies);
+    *appended = replacement + user->policiesLen;
+    free(user->policies);
+    user->policies = replacement;
+    user->policiesLen += count;
+    return S_OK;
+}
