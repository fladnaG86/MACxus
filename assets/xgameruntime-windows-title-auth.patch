+/* Legacy Windows packages use TitleId instead of MSAAppId. The title token
+ * must belong to the same device/proof key as this user's existing chain. */
+static HRESULT windows_title_auth( XUserHandle user )
+{
+    static const char format[] = "{\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\","
+        "\"Properties\":{\"DeviceToken\":\"%s\",\"TitleId\":%lu,\"ProofKey\":%s}}";
+    IJsonObject *object = NULL;
+    HSTRING token = NULL;
+    char *body = NULL, *replacement = NULL;
+    BYTE *buffer = NULL;
+    SIZE_T body_size = 0, buffer_size = 0;
+    DWORD status = 0;
+    int body_length, written;
+    HRESULT hr = E_INVALIDARG;
+
+    if (!titleId || !user->deviceToken || !user->proofKey) goto cleanup;
+    for (const unsigned char *c = (const unsigned char *)user->deviceToken; *c; ++c)
+        if (*c < 0x20 || *c == '"' || *c == '\\') goto cleanup;
+    if (strlen(user->deviceToken) > 1024 * 1024 || strlen(user->proofKey) > 1024 * 1024) goto cleanup;
+    body_length = snprintf(NULL, 0, format, user->deviceToken, (unsigned long)titleId, user->proofKey);
+    if (body_length <= 0 || body_length >= 1024 * 1024) goto cleanup;
+    body_size = (SIZE_T)body_length + 1;
+    if (!(body = calloc(1, body_size))) { hr = E_OUTOFMEMORY; goto cleanup; }
+    written = snprintf(body, body_size, format, user->deviceToken, (unsigned long)titleId, user->proofKey);
+    if (written != body_length) goto cleanup;
+    hr = xuser_signed_request(user, "POST", "https://title.auth.xboxlive.com/title/authenticate", NULL,
+        "x-xbl-contract-version: 1\r\nContent-Type: application/json\r\n",
+        body, strlen(body), &status, &buffer, &buffer_size);
+    if (FAILED(hr)) goto cleanup;
+    if (status != 200) { hr = E_ACCESSDENIED; goto cleanup; }
+    if (FAILED(hr = parse_json((char *)buffer, buffer_size, &object))) goto cleanup;
+    if (FAILED(hr = get_json_string(object, L"Token", &token))) goto cleanup;
+    if (!(replacement = hstring_to_utf8(token))) { hr = E_OUTOFMEMORY; goto cleanup; }
+    if (!*replacement) { hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA); goto cleanup; }
+    if (user->titleToken) { SecureZeroMemory(user->titleToken, strlen(user->titleToken)); free(user->titleToken); }
+    user->titleToken = replacement;
+    replacement = NULL;
+    hr = S_OK;
+cleanup:
+    auth_metadata("windows-title", user, hr, status, TRUE, SUCCEEDED(hr));
+    if (object) IJsonObject_Release(object);
+    if (token) WindowsDeleteString(token);
+    if (buffer) { SecureZeroMemory(buffer, buffer_size); free(buffer); }
+    if (body) { SecureZeroMemory(body, body_size); free(body); }
+    if (replacement) { SecureZeroMemory(replacement, strlen(replacement)); free(replacement); }
+    return hr;
+}
