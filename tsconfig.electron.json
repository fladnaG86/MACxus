{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"],
    "allowJs": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.cts", "src/shared/**/*.ts", "src/shared/compatibility-pack-schema.mjs", "src/shared/runtime-pack-schema.mjs"],
  "exclude": ["**/*.test.ts"]
}
